{
    "name": "httpx/tournament-management-system",
    "description": "School tournament management system - manage competitions, teams, students, and scoring",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 0
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public/",
        "console": "php console",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "lint:syntax": "find app console public views -name '*.php' -print0 | xargs -0 -n1 php -l",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@lint:syntax",
            "@analyse",
            "@test"
        ]
    }
}
